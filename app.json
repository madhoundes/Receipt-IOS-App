{
  "expo": {
    "name": "Maplestub",
    "slug": "maplestub",
    "scheme": "maplestub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maplestub.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Maplestub uses the camera to scan your receipts.",
        "NSPhotoLibraryUsageDescription": "Maplestub imports receipt photos from your library."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.maplestub.app",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Maplestub uses the camera to scan your receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Maplestub imports receipt photos from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B7A55"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
