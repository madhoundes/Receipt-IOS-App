{
  "name": "Receipt TaX iOS Design Tokens",
  "version": "2.0.0",
  "font": {
    "family": "SF Pro Display",
    "mono": "SF Mono",
    "note": "Use system text styles (.font(.largeTitle) etc.) so Dynamic Type scales. Tabular digits for all money: .monospacedDigit()."
  },
  "color": {
    "brand": {
      "brandPrimary": { "light": "#0B7A55", "dark": "#34C98E" },
      "brandTint": { "light": "#E4F3EC", "dark": "#0F2E22" },
      "hstAccent": { "light": "#B35C00", "dark": "#FFB057" },
      "hstTint": { "light": "#FFF1DE", "dark": "#3A2710" },
      "paper": { "light": "#FFFDF7", "dark": "#1F1E1A" },
      "paperInk": { "light": "#23211C", "dark": "#ECE8DC" }
    },
    "system": {
      "systemGroupedBackground": { "light": "#F2F2F7", "dark": "#000000" },
      "secondarySystemGroupedBackground": { "light": "#FFFFFF", "dark": "#1C1C1E" },
      "label": { "light": "#111113", "dark": "#FFFFFF" },
      "secondaryLabel": { "light": "#6C6C70", "dark": "#AEAEB2" },
      "separator": { "light": "#E0E0E5", "dark": "#38383A" },
      "systemRed": { "light": "#D70015", "dark": "#FF6961" }
    },
    "category": {
      "grocery": { "fg": "#1E7A35", "tint": "#E5F5E8", "sfSymbol": "cart" },
      "gas": { "fg": "#B04A08", "tint": "#FDEEE3", "sfSymbol": "fuelpump" },
      "digitalServices": { "fg": "#0A5BC4", "tint": "#E6EFFC", "sfSymbol": "icloud" },
      "dining": { "fg": "#B8185A", "tint": "#FBE7EF", "sfSymbol": "fork.knife" },
      "transport": { "fg": "#5A3CC2", "tint": "#EEEAFB", "sfSymbol": "car" },
      "office": { "fg": "#0B6E77", "tint": "#E2F3F4", "sfSymbol": "briefcase" },
      "other": { "fg": "#555559", "tint": "#EFEFF1", "sfSymbol": "tag" }
    }
  },
  "typeScale": {
    "largeTitle": { "size": 34, "lineHeight": 41, "weight": "bold" },
    "title1": { "size": 28, "lineHeight": 34, "weight": "bold" },
    "title2": { "size": 22, "lineHeight": 28, "weight": "bold" },
    "title3": { "size": 20, "lineHeight": 25, "weight": "semibold" },
    "headline": { "size": 17, "lineHeight": 22, "weight": "semibold" },
    "body": { "size": 17, "lineHeight": 22, "weight": "regular" },
    "callout": { "size": 16, "lineHeight": 21, "weight": "regular" },
    "subheadline": { "size": 15, "lineHeight": 20, "weight": "regular" },
    "footnote": { "size": 13, "lineHeight": 18, "weight": "regular" },
    "caption1": { "size": 12, "lineHeight": 16, "weight": "medium" },
    "caption2": { "size": 11, "lineHeight": 13, "weight": "medium" },
    "amountDisplay": { "size": 44, "lineHeight": 50, "weight": "bold", "digits": "tabular" }
  },
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 24, "xxl": 32, "tapTarget": 44 },
  "radius": { "chip": 8, "field": 12, "card": 16, "sheet": 22, "capsule": 999, "style": "continuous" },
  "motion": {
    "system": "steady (no morph): only position, scale, opacity and trim paths animate",
    "easeInOut": [0.35, 0, 0.65, 1],
    "easeOut": [0.2, 0, 0.3, 1],
    "maxTravelPt": 180,
    "scaleRange": [0.7, 1.1],
    "errorShake": { "amplitudePt": 4, "durationS": 0.5, "repeats": 1 },
    "reduceMotion": "show a still frame with .currentProgress(0.6)"
  }
}
